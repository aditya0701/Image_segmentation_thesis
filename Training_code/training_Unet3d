class SupervisedCrop3DDataset(Dataset):
    """
    Loads pairs of (Image, Label).
    Ensures Image is 2-Channel (Green+Red) and Label is 1-Channel (Mask).
    Performs synchronized random cropping.
    """
    def __init__(self, image_folder, label_folder, patch_size=64, samples_per_epoch=100):
        self.image_folder = Path(image_folder)
        self.label_folder = Path(label_folder)
        self.patch_size = patch_size
        self.samples_per_epoch = samples_per_epoch
        
        # Get list of files
        self.image_paths = sorted(list(self.image_folder.glob("*.tif")))
        self.data_pairs = []
        
        print(f"Scanning for matching labels in {label_folder}...")
        
        for img_p in self.image_paths:
            # Expecting label to have same name as image
            lbl_p = self.label_folder / img_p.name
            
            if lbl_p.exists():
                # Load Image
                img = tifffile.imread(img_p).astype(np.float32)
                # Load Label (Convert to Integer 0/1)
                lbl = tifffile.imread(lbl_p).astype(np.uint8)
                
                # --- PREPROCESSING (Same as before) ---
                # Fix Image Dimensions -> (C, Z, Y, X)
                if img.ndim == 3: img = img[np.newaxis, ...]
                elif img.ndim == 4:
                    if img.shape[1] <= 4: img = np.transpose(img, (1, 0, 2, 3))
                    elif img.shape[3] <= 4: img = np.transpose(img, (3, 0, 1, 2))
                
                # Filter Channels (Keep 2)
                if img.shape[0] >= 2: img = img[0:2, ...]
                
                # Normalize Image
                for c in range(img.shape[0]):
                    low, high = np.percentile(img[c], (0.1, 99.9))
                    if high > low:
                        img[c] = np.clip((img[c]-low)/(high-low), 0, 1)
                
                # Fix Label Dimensions -> (1, Z, Y, X)
                if lbl.ndim == 3: lbl = lbl[np.newaxis, ...]
                # Ensure binary (0 and 1)
                lbl = (lbl > 0).astype(np.uint8)
                
                self.data_pairs.append((img, lbl))
            else:
                # print(f"Warning: No label found for {img_p.name}, skipping.")
                pass
                
        if len(self.data_pairs) == 0:
            raise ValueError("No matching (Image, Label) pairs found! Check your filenames.")
            
        print(f"Successfully loaded {len(self.data_pairs)} training pairs.")

    def __len__(self):
        return self.samples_per_epoch

    def __getitem__(self, idx):
        # 1. Pick Random Pair
        idx = np.random.randint(0, len(self.data_pairs))
        img, lbl = self.data_pairs[idx]
        
        # 2. Pick Random Crop Coordinates
        z_max = max(0, img.shape[1] - self.patch_size)
        y_max = max(0, img.shape[2] - self.patch_size)
        x_max = max(0, img.shape[3] - self.patch_size)
        
        z = np.random.randint(0, z_max + 1)
        y = np.random.randint(0, y_max + 1)
        x = np.random.randint(0, x_max + 1)
        
        # 3. Crop BOTH Image and Label at exact same spot
        img_patch = img[:, z:z+self.patch_size, y:y+self.patch_size, x:x+self.patch_size]
        lbl_patch = lbl[:, z:z+self.patch_size, y:y+self.patch_size, x:x+self.patch_size]
        
        # 4. Padding (if image is smaller than patch)
        if img_patch.shape[1:] != (self.patch_size, self.patch_size, self.patch_size):
             pad_shape = (self.patch_size, self.patch_size, self.patch_size)
             
             pad_img = np.zeros((img.shape[0], *pad_shape), dtype=np.float32)
             pad_img[:, :img_patch.shape[1], :img_patch.shape[2], :img_patch.shape[3]] = img_patch
             img_patch = pad_img
             
             pad_lbl = np.zeros((lbl.shape[0], *pad_shape), dtype=np.uint8)
             pad_lbl[:, :lbl_patch.shape[1], :lbl_patch.shape[2], :lbl_patch.shape[3]] = lbl_patch
             lbl_patch = pad_lbl

        return torch.tensor(img_patch), torch.tensor(lbl_patch)

def save_plot(history, folder):
    plt.figure(figsize=(10, 6))
    plt.plot(history['epoch'], history['loss'], label='DiceCE Loss')
    plt.title('Supervised U-Net Training')
    plt.xlabel('Epoch')
    plt.ylabel('Loss')
    plt.legend()
    plt.grid(True)
    plt.savefig(os.path.join(folder, "loss_curve.png"))
    plt.close()

def save_preview(image, label, output, folder, epoch):
    # Slice the middle of the 3D patch
    mid = image.shape[2] // 2
    
    img_green = image[0, 0, mid, :, :].cpu().numpy() # Raw Green
    true_lbl  = label[0, 0, mid, :, :].cpu().numpy() # Manual Label
    
    # Argmax to get class 0 vs 1
    pred_lbl  = torch.argmax(output, dim=1)[0, mid, :, :].detach().cpu().numpy() 
    
    # Normalize for TIF display
    def norm(arr): return ((arr - arr.min()) / (arr.max() - arr.min() + 1e-8) * 255).astype(np.uint8)
    
    # Stack: Raw Image | Human Label | AI Prediction
    combined = np.hstack((norm(img_green), norm(true_lbl), norm(pred_lbl)))
    tifffile.imwrite(os.path.join(folder, f"vis_epoch_{epoch}.tif"), combined)

def train():
    # 1. SETUP FOLDER & DEVICE
    run_name = f"UNet_lr{CONFIG['LEARNING_RATE']}_patch{CONFIG['PATCH_SIZE']}"
    run_folder = os.path.join(CONFIG["SAVE_FOLDER"], run_name)
    os.makedirs(run_folder, exist_ok=True)
    
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"🚀 Training: {run_name} on {device}")
    
    # 2. DEFINE MODEL (BasicUNet)
    # in_channels=2 (Green, Red)
    # out_channels=2 (Background, Foreground)
    model = BasicUNet(
        spatial_dims=3,
        in_channels=2,
        out_channels=2,
        features=(32, 32, 64, 128, 256, 32)
    ).to(device)
    
    # 3. DATA & OPTIMIZER
    dataset = SupervisedCrop3DDataset(CONFIG["IMAGE_FOLDER"], CONFIG["LABEL_FOLDER"], CONFIG["PATCH_SIZE"])
    dataloader = DataLoader(dataset, batch_size=CONFIG["BATCH_SIZE"], shuffle=True, num_workers=0)
    
    optimizer = torch.optim.Adam(model.parameters(), lr=CONFIG["LEARNING_RATE"])
    
    # DiceCELoss is standard for segmentation
    # to_onehot_y=True splits your single channel label [0,1] into 2 channels [1,0] and [0,1]
    loss_function = DiceCELoss(to_onehot_y=True, softmax=True)
    
    # 4. LOOP
    history = {"epoch": [], "loss": []}
    model.train()
    
    for epoch in range(1, CONFIG["EPOCHS"] + 1):
        epoch_loss = 0
        for batch_img, batch_lbl in dataloader:
            batch_img, batch_lbl = batch_img.to(device), batch_lbl.to(device)
            
            optimizer.zero_grad()
            outputs = model(batch_img)
            
            loss = loss_function(outputs, batch_lbl)
            loss.backward()
            optimizer.step()
            
            epoch_loss += loss.item()
            
        avg_loss = epoch_loss / len(dataloader)
        print(f"Epoch {epoch} | Loss: {avg_loss:.4f}")
        
        history["epoch"].append(epoch)
        history["loss"].append(avg_loss)
        
        if epoch % CONFIG["SAVE_INTERVAL"] == 0:
            torch.save(model.state_dict(), os.path.join(run_folder, "model.pth"))
            pd.DataFrame(history).to_csv(os.path.join(run_folder, "log.csv"), index=False)
            save_plot(history, run_folder)
            save_preview(batch_img, batch_lbl, outputs, run_folder, epoch)
            
    # Final Save
    torch.save(model.state_dict(), os.path.join(run_folder, "model_final.pth"))
    print("✅ Training Complete.")

if __name__ == "__main__":
    train()