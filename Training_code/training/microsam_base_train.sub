######################################################################
# microsam_base_train.sub — HTCondor submit file for vit_b_lm training
# args = <dataset> [--augmented]
# dataset: all | dog | original | psf
# Examples:
#   condor_submit microsam_base_train.sub -a "args=all --augmented"
#   condor_submit microsam_base_train.sub -a "args=all"
######################################################################

cmd          = /work/scratch/rawat/image-segmentation-thesis/Training_code/training/run_microsam_base.sh
args         =
initialdir   = /work/scratch/rawat

output = /work/scratch/rawat/image-segmentation-thesis/logs_microsam_base/loc_$(cluster).$(Process)_out.log
error  = /work/scratch/rawat/image-segmentation-thesis/logs_microsam_base/loc_$(cluster).$(Process)_err.log
log    = /work/scratch/rawat/image-segmentation-thesis/logs_microsam_base/loc_$(cluster).$(Process)_log.log

getenv        = True
on_exit_hold  = (ExitBySignal == True) || (ExitCode != 0)
nice_user     = True

request_cpus  = 8
request_gpus  = 1
request_memory = 32 GB
request_disk  = 50 GB

requirements  = (GPUs_GlobalMemoryMb >= 20000) && (GPUs_GlobalMemoryMb < 30000)
rank          = memory

queue
