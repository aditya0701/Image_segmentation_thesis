######################################################################
# swinunetr_train.tbi — HTCondor submit file for SwinUNETR training
#
# Usage: condor_submit swinunetr_train.tbi -a "args=<dataset>"
#
#   condor_submit swinunetr_train.tbi -a "args=all"
#   condor_submit swinunetr_train.tbi -a "args=dog"
#   condor_submit swinunetr_train.tbi -a "args=original"
#   condor_submit swinunetr_train.tbi -a "args=psf"
######################################################################

cmd          = /work/scratch/rawat/image-segmentation-thesis/Training_code/training/run_swinunetr.sh
args         =
initialdir   = /work/scratch/rawat

output = /work/scratch/rawat/image-segmentation-thesis/logs_swinunetr/loc_$(cluster).$(Process)_out.log
error  = /work/scratch/rawat/image-segmentation-thesis/logs_swinunetr/loc_$(cluster).$(Process)_err.log
log    = /work/scratch/rawat/image-segmentation-thesis/logs_swinunetr/loc_$(cluster).$(Process)_log.log

getenv        = True
on_exit_hold  = (ExitBySignal == True) || (ExitCode != 0)
nice_user     = True

request_cpus   = 8
request_gpus   = 1
request_memory = 32 GB
request_disk   = 50 GB

requirements  = (GPUs_GlobalMemoryMb >= 20000) && (GPUs_GlobalMemoryMb < 40000)
rank          = memory

queue
